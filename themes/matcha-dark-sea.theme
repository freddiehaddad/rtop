#Bashtop matcha-dark-sea theme
#by TheCynicalTeam

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#FFFFFF", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#F8F8F2"

# Title color for boxes
theme[title]="#F8F8F2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#2eb398"

# Background color of selected item in processes box
theme[selected_bg]="#0d493d"

# Foreground color of selected item in processes box
theme[selected_fg]="#F8F8F2"

# Color of inactive/disabled text
theme[inactive_fg]="#595647"

# Background color of the percentage meters
theme[meter_bg]="#595647"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#797667"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#33b165"

# Color of process tree prefix lines
theme[proc_tree_fg]="#595647"

# Cpu box outline color
theme[cpu_box]="#75715E"

# Memory/disks box outline color
theme[mem_box]="#75715E"

# Net up/down box outline color
theme[net_box]="#75715E"

# Processes box outline color
theme[proc_box]="#75715E"

# Gpu box outline color
theme[gpu_box]="#75715E"

# Disk box outline color
theme[disk_box]="#75715E"

# Help menu box outline color
theme[help_box]="#75715E"

# Options menu box outline color
theme[options_box]="#75715E"

# Box divider line and small boxes line color
theme[div_line]="#595647"

# Temperature graph colors
theme[temp_start]="#7976B7"
theme[temp_mid]="#D8B8B2"
theme[temp_end]="#33b165"

# CPU graph colors
theme[cpu_start]="#33b165"
theme[cpu_mid]="#F8F8F2" #2eb398"
theme[cpu_end]="#2eb398"

# Mem/Disk free meter
theme[free_start]="#75715E"
theme[free_mid]="#a9c474"
theme[free_end]="#e2f5bc"

# Mem/Disk cached meter
theme[cached_start]="#75715E"
theme[cached_mid]="#66D9EF"
theme[cached_end]="#aae7f2"

# Mem/Disk available meter
theme[available_start]="#75715E"
theme[available_mid]="#E6DB74"
theme[available_end]="#f2ecb6"

# Mem/Disk used meter
theme[used_start]="#75715E"
theme[used_mid]="#2eb398"
theme[used_end]="#33b165"

# Download graph colors
theme[download_start]="#2d2042"
theme[download_mid]="#2eb398"
theme[download_end]="#33b165"

# Upload graph colors
theme[upload_start]="#0d493d"
theme[upload_mid]="#2eb398"
theme[upload_end]="#33b165"
# Disk read graph colors
theme[disk_read_start]="#2d2042"
theme[disk_read_mid]="#2eb398"
theme[disk_read_end]="#33b165"

# Disk write graph colors
theme[disk_write_start]="#0d493d"
theme[disk_write_mid]="#2eb398"
theme[disk_write_end]="#33b165"

# Disk busy meter colors
theme[disk_busy_start]="#75715E"
theme[disk_busy_mid]="#2eb398"
theme[disk_busy_end]="#33b165"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#33b165"
theme[process_mid]="#F8F8F2"
theme[process_end]="#2eb398"

# Process list banner attributes
theme[proc_pause_bg]="#33b165"
theme[proc_follow_bg]="#2d2042"
theme[proc_banner_bg]="#0d493d"
theme[proc_banner_fg]="#F8F8F2"

# Process following attributes
theme[followed_bg]="#2d2042"
theme[followed_fg]="#F8F8F2"

# GPU utilization meter
theme[gpu_start]="#33b165"
theme[gpu_mid]="#F8F8F2"
theme[gpu_end]="#2eb398"

# GPU clock speed meter
theme[gpu_clock_start]="#2eb398"
theme[gpu_clock_mid]="#66D9EF"
theme[gpu_clock_end]="#aae7f2"

# GPU power draw meter
theme[gpu_power_start]="#E6DB74"
theme[gpu_power_mid]="#f2ecb6"
theme[gpu_power_end]="#FD971F"

# GPU VRAM usage meter
theme[gpu_vram_start]="#AE81FF"
theme[gpu_vram_mid]="#9b6bcd"
theme[gpu_vram_end]="#7c5fbf"
