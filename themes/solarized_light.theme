#solarized_light theme
#modified from solarized_dark theme

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#FFFFFF", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#fdf6e3"

# Main text color
theme[main_fg]="#586e75"

# Title color for boxes
theme[title]="#002b36"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b58900"

# Background color of selected items
theme[selected_bg]="#eee8d5" 

# Foreground color of selected items
theme[selected_fg]="#b58900"

# Color of inactive/disabled text
theme[inactive_fg]="#eee8d5"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#eee8d5"

# Background color of the percentage meters
theme[meter_bg]="#eee8d5"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#d33682"

# Color of process tree prefix lines
theme[proc_tree_fg]="#eee8d5"

# Cpu box outline color
theme[cpu_box]="#93a1a1"

# Memory/disks box outline color
theme[mem_box]="#93a1a1"

# Net up/down box outline color
theme[net_box]="#93a1a1"

# Processes box outline color
theme[proc_box]="#93a1a1"

# Gpu box outline color
theme[gpu_box]="#93a1a1"

# Disk box outline color
theme[disk_box]="#93a1a1"

# Help menu box outline color
theme[help_box]="#93a1a1"

# Options menu box outline color
theme[options_box]="#93a1a1"

# Box divider line and small boxes line color
theme[div_line]="#93a1a1"

# Temperature graph colors
theme[temp_start]="#268bd2"
theme[temp_mid]="#ccb5f7"
theme[temp_end]="#fc5378"

# CPU graph colors
theme[cpu_start]="#adc700"
theme[cpu_mid]="#d6a200"
theme[cpu_end]="#e65317"

# Mem/Disk free meter
theme[free_start]="#4e5900"
theme[free_mid]=""
theme[free_end]="#bad600"

# Mem/Disk cached meter
theme[cached_start]="#114061"
theme[cached_mid]=""
theme[cached_end]="#268bd2"

# Mem/Disk available meter
theme[available_start]="#705500"
theme[available_mid]=""
theme[available_end]="#edb400"

# Mem/Disk used meter
theme[used_start]="#6e1718"
theme[used_mid]=""
theme[used_end]="#e02f30"

# Download graph colors
theme[download_start]="#3d4070"
theme[download_mid]="#6c71c4"
theme[download_end]="#a3a8f7"

# Upload graph colors
theme[upload_start]="#701c45"
theme[upload_mid]="#d33682"
theme[upload_end]="#f56caf"
# Disk read graph colors
theme[disk_read_start]="#3d4070"
theme[disk_read_mid]="#6c71c4"
theme[disk_read_end]="#a3a8f7"

# Disk write graph colors
theme[disk_write_start]="#701c45"
theme[disk_write_mid]="#d33682"
theme[disk_write_end]="#f56caf"

# Disk busy meter colors
theme[disk_busy_start]="#6e1718"
theme[disk_busy_mid]=""
theme[disk_busy_end]="#e02f30"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#adc700"
theme[process_mid]="#d6a200"
theme[process_end]="#e65317"

# Process list banner attributes
theme[proc_pause_bg]="#e02f30"
theme[proc_follow_bg]="#3d4070"
theme[proc_banner_bg]="#eee8d5"
theme[proc_banner_fg]="#b58900"

# Process following attributes
theme[followed_bg]="#3d4070"
theme[followed_fg]="#b58900"

# GPU utilization meter
theme[gpu_start]="#adc700"
theme[gpu_mid]="#d6a200"
theme[gpu_end]="#e65317"

# GPU clock speed meter
theme[gpu_clock_start]="#268bd2"
theme[gpu_clock_mid]="#2aa198"
theme[gpu_clock_end]="#859900"

# GPU power draw meter
theme[gpu_power_start]="#cb4b16"
theme[gpu_power_mid]="#d6a200"
theme[gpu_power_end]="#e65317"

# GPU VRAM usage meter
theme[gpu_vram_start]="#6c71c4"
theme[gpu_vram_mid]="#d33682"
theme[gpu_vram_end]="#dc322f"
